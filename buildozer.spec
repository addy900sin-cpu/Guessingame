[app]

# App name
title = Guessing Game

# Package name
package.name = guessinggame

# Package domain
package.domain = org.addy

# Source folder
source.dir = .

# Main Python file
entrypoint = main.py

# Version
version = 1.0

# Requirements
requirements = python3,kivy

# Orientation
orientation = portrait

# Fullscreen
fullscreen = 0

# Android permissions
android.permissions =

# Android API
android.api = 35

# Minimum Android API
android.minapi = 23

# Android architecture
android.arch = arm64-v8a, armeabi-v7a

# Keep screen on
android.allow_backup = True

# Log level
log_level = 2


[buildozer]

# Log level
log_level = 2

# Warning mode
warn_on_root = 1
